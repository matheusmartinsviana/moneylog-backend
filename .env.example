# Copie para .env (que está no .gitignore) e preencha. Nunca commite valores reais.
#
# ATENÇÃO com "$": o Docker Compose interpola "$VAR" no .env inteiro, e o shell também (ao fazer
# "set -a; source .env"). Valores com "$" (ex.: hash BCrypt "$2a$10$...") precisam ficar entre
# ASPAS SIMPLES, que o Compose e o shell tratam como literal. Sem aspas, o hash é corrompido em silêncio.

# --- Banco (docker-compose.yml e backend) ---
DB_NAME=moneylog
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/moneylog
DB_USER=moneylog
DB_PASSWORD=

# --- Segurança (Etapa 2) ---
# Segredo do JWT: no mínimo 32 bytes aleatórios (ex.: openssl rand -base64 48).
JWT_SECRET=
# Dono único do app (sem cadastro público). O hash é BCrypt e vai entre aspas simples:
# MONEYLOG_OWNER_PASSWORD_HASH='$2a$10$...'
MONEYLOG_OWNER_EMAIL=
MONEYLOG_OWNER_PASSWORD_HASH=''
# Alternativa ao hash direto: caminho de um arquivo que contém só o hash (evita o problema do "$").
MONEYLOG_OWNER_PASSWORD_HASH_FILE=
# Origens do front aceitas no refresh e no logout (CSRF), separadas por vírgula. Em produção, só o domínio do app.
MONEYLOG_ALLOWED_ORIGINS=https://moneylog.localhost:4200,https://localhost:4200
# CIDRs dos proxies de confiança (CloudFront/ALB) para ler o IP em X-Forwarded-For. Vazio = ignora o header.
MONEYLOG_TRUSTED_PROXIES=

# --- Push (Etapa 7; PREPARADO e DESLIGADO) ---
# O push só liga com moneylog.push.enabled=true (application.yaml) E as três variáveis abaixo; sem elas o app não sobe.
# Gere o par VAPID (P-256, base64url) com `npx web-push generate-vapid-keys`. SUBJECT: mailto:voce@exemplo.com ou https://seu-dominio.
# Exige HTTPS real e a PWA instalada (no iPhone, iOS 16.4+). A central de notificações dentro do app funciona sem nada disso.
MONEYLOG_PUSH_VAPID_PUBLIC=
MONEYLOG_PUSH_VAPID_PRIVATE=
MONEYLOG_PUSH_VAPID_SUBJECT=

# --- IA (Etapa 8; opcional) ---
# "none" (padrão) desliga a IA e o app funciona normalmente. "anthropic" exige AI_API_KEY e AI_MODEL, senão o app não sobe.
# "fake" é só para dev/teste (o app não sobe com "fake" no perfil prod).
# A chave existe SOMENTE aqui, no ambiente do servidor: nunca no front, nunca em log. Cada envio exige prévia aprovada pelo usuário.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# URL base do provedor (vazio = a oficial). Sem credenciais na URL.
AI_BASE_URL=
# Timeout de cada chamada ao provedor, em segundos.
AI_TIMEOUT_SECONDS=30
# Limite de chamadas por dia e orçamento mensal de tokens (entrada + saída).
AI_DAILY_CALL_LIMIT=50
AI_MONTHLY_TOKEN_BUDGET=500000
# Dias em que o payload enviado fica no histórico; depois só o registro permanece.
AI_PAYLOAD_RETENTION_DAYS=90
